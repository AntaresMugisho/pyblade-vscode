{
  "name": "PyBlade",
  "scopeName": "source.pyblade",
  "fileTypes": [
    "html",
    "pyblade"
  ],
  "injections": {
    "L:source.pyblade meta.tag": {
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "#directives"
        }
      ]
    }
  },
  "patterns": [
    {
      "name": "comment.block.pyblade",
      "begin": "\\{#",
      "end": "#\\}"
    },
    {
      "name": "comment.block.pyblade",
      "begin": "(?<![\\w@])@comment\\b",
      "end": "@endcomment"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#directives"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.echo.pyblade",
          "begin": "\\{\\{",
          "end": "\\}\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.pyblade"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.pyblade"
            }
          },
          "contentName": "source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "name": "meta.embedded.echo.raw.pyblade",
          "begin": "\\{!!",
          "end": "!!\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.raw.pyblade"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.raw.pyblade"
            }
          },
          "contentName": "source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "constant.character.escape.pyblade",
          "match": "@@(?=\\w)"
        },
        {
          "begin": "(?<![\\w@])@(unless|switch|match|elif|case|if)\\b\\s*\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.conditional.pyblade"
            }
          },
          "contentName": "meta.arguments.pyblade source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "(?<![\\w@])@(resetcycle|ifchanged|continue|break|cycle|for)\\b\\s*\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.loop.pyblade"
            }
          },
          "contentName": "meta.arguments.pyblade source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "(?<![\\w@])@(active|error)\\b\\s*\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.auth.pyblade"
            }
          },
          "contentName": "meta.arguments.pyblade source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "(?<![\\w@])@(extends|include)\\b\\s*\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.import.pyblade"
            }
          },
          "contentName": "meta.arguments.pyblade source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "(?<![\\w@])@(component|section|block|yield|stack|push|slot)\\b\\s*\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "storage.type.layout.pyblade"
            }
          },
          "contentName": "meta.arguments.pyblade source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "(?<![\\w@])@(props|with)\\b\\s*\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.scope.pyblade"
            }
          },
          "contentName": "meta.arguments.pyblade source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "(?<![\\w@])@(blocktranslate|blocktrans|translate|languages|plural|trans|lang)\\b\\s*\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "support.function.i18n.pyblade"
            }
          },
          "contentName": "meta.arguments.pyblade source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "(?<![\\w@])@(autofocus|selected|required|multiple|readonly|checked|class|style|field)\\b\\s*\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "support.function.attribute.pyblade"
            }
          },
          "contentName": "meta.arguments.pyblade source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "(?<![\\w@])@(querystring|widthratio|firstof|regroup|static|ratio|lorem|url|now)\\b\\s*\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "support.function.helper.pyblade"
            }
          },
          "contentName": "meta.arguments.pyblade source.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "name": "keyword.control.conditional.pyblade",
          "match": "(?<![\\w@])@(default|unless|switch|match|elif|else|case|if)\\b"
        },
        {
          "name": "keyword.control.conditional.pyblade",
          "match": "(?<!@)@(endunless|endswitch|endmatch|endif)\\b"
        },
        {
          "name": "keyword.control.loop.pyblade",
          "match": "(?<![\\w@])@(resetcycle|ifchanged|continue|empty|break|cycle|for)\\b"
        },
        {
          "name": "keyword.control.loop.pyblade",
          "match": "(?<!@)@(endifchanged|endfor)\\b"
        },
        {
          "name": "keyword.control.auth.pyblade",
          "match": "(?<![\\w@])@(anonymous|active|guest|error|auth)\\b"
        },
        {
          "name": "keyword.control.auth.pyblade",
          "match": "(?<!@)@(endanonymous|endactive|endguest|enderror|endauth)\\b"
        },
        {
          "name": "keyword.control.import.pyblade",
          "match": "(?<![\\w@])@(extends|include)\\b"
        },
        {
          "name": "storage.type.layout.pyblade",
          "match": "(?<![\\w@])@(component|section|persist|parent|script|block|yield|stack|push|slot)\\b"
        },
        {
          "name": "storage.type.layout.pyblade",
          "match": "(?<!@)@(endcomponent|endsection|endpersist|endscript|endblock|endstack|endpush|endslot)\\b"
        },
        {
          "name": "keyword.other.scope.pyblade",
          "match": "(?<![\\w@])@(spaceless|verbatim|comment|props|with)\\b"
        },
        {
          "name": "keyword.other.scope.pyblade",
          "match": "(?<!@)@(endspaceless|endverbatim|endcomment|endwith)\\b"
        },
        {
          "name": "support.function.i18n.pyblade",
          "match": "(?<![\\w@])@(blocktranslate|blocktrans|translate|languages|plural|trans|lang)\\b"
        },
        {
          "name": "support.function.i18n.pyblade",
          "match": "(?<!@)@(endblocktranslate|endblocktrans)\\b"
        },
        {
          "name": "support.function.attribute.pyblade",
          "match": "(?<![\\w@])@(autofocus|selected|required|multiple|readonly|checked|class|style|field)\\b"
        },
        {
          "name": "support.function.helper.pyblade",
          "match": "(?<![\\w@])@(get_static_prefix|get_media_prefix|querystring|widthratio|pbscripts|pbstyles|firstof|regroup|static|ratio|lorem|debug|csrf|url|now|gsp|gmp)\\b"
        }
      ]
    }
  }
}
