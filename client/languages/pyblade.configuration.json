{
    "comments": {
      "blockComment": ["{#", "#}"]
    },

    "brackets": [
      ["(", ")"],
      ["{", "}"],
      ["{{",    "}}"],
      ["{!!", "!!}"]
    ],

    "autoClosingPairs": [
        { "open": "'", "close": "'", "notIn": ["comment"] },
        { "open": "`", "close": "`", "notIn": ["string", "comment"]  },
        { "open": "\"", "close": "\"", "notIn": ["comment"]  },
        { "open": "\"\"\"", "close": "\"\"\"", "notIn": ["string"] },
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "{", "close": "}" },
        { "open": "{{", "close": "}}" },
        { "open": "{!!", "close": "!!}" },
        { "open": "{#", "close": "#}" }
    ],

    "surroundingPairs": [
      { "open": "{", "close": "}" },
      { "open": "[", "close": "]" },
      { "open": "(", "close": ")" },
      { "open": "'", "close": "'" },
      { "open": "\"", "close": "\"" },
      { "open": "`", "close": "`" },
      { "open": "\"\"\"", "close": "\"\"\""}
    ],

    "folding": {
      "markers": {
        "start": "^\\s*@(?:verbatim|spaceless|comment|if|unless|auth|guest|anonymous|match|switch|for|error|with|active|ifchanged|blocktranslate|blocktrans|component|block|section|push|slot|script|persist)\\b(?!.*@end\\w+).*$",
        "end": "^\\s*@(?:endverbatim|endspaceless|endcomment|endif|endunless|endauth|endguest|endanonymous|endmatch|endswitch|endfor|enderror|endwith|endactive|endifchanged|endblocktranslate|endblocktrans|endcomponent|endblock|endsection|endpush|endslot|endscript|endpersist)\\b.*$"
      }
    }
  }
  