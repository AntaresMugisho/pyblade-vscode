{
  "PyBlade if Statement": {
    "prefix": "@if",
    "body": ["@if(${1:condition})", "\t$0", "@endif"],
    "description": "Insert a PyBlade @if statement"
  },
  "PyBlade elif": {
    "prefix": "@elif",
    "body": ["@elif(${1:condition})", "\t$0"],
    "description": "PyBlade @elif directive"
  },
  "PyBlade else": {
    "prefix": "@else",
    "body": ["@else", "\t$0"],
    "description": "PyBlade @else directive"
  },
  "PyBlade if and else statement": {
    "prefix": "@ifelse",
    "body": ["@if(${1:condition})", "\t$2", "@else", "\t$0", "@endif"],
    "description": "Insert a PyBlade @if ... @else statement"
  },
  "PyBlade if and elif Statement": {
    "prefix": "@ifelif",
    "body": ["@if(${1:condition})", "\t$2", "@elif(${3:condition})", "\t$0", "@endif"],
    "description": "Insert a PyBlade @if ... @elif statement"
  },
  "PyBlade if, elif and else Statement": {
    "prefix": "@ifelifelse",
    "body": ["@if(${1:condition})", "\t$2", "@elif(${3:condition})", "\t$4", "@else", "\t$0", "@endif"],
    "description": "Insert a PyBlade @if ... @elif ... @else statement"
  },
  "PyBlade unless": {
    "prefix": "@unless",
    "body": ["@unless(${1:condition})", "\t$0", "@endunless"],
    "description": "PyBlade @unless directive"
  },

  "PyBlade switch statement": {
    "prefix": "@switch",
    "body": ["@switch(${1:variable})", "\t@case(${2:value})", "\t\t$3", "\t@default", "\t\t$0", "@endswitch"],
    "description": "PyBlade @switch directive"
  },
  "PyBlade case statement": {
    "prefix": "@case",
    "body": ["@case(${1:value})", "\t$0"],
    "description": "PyBlade @case directive"
  },
  "PyBlade default statement": {
    "prefix": "@default",
    "body": ["@default", "\t$0"],
    "description": "PyBlade @default directive"
  },
  "PyBlade match statement": {
    "prefix": "@match",
    "body": ["@match(${1:variable})", "\t@case(${2:value})", "\t\t$3", "\t@default", "\t\t$0", "@endmatch"],
    "description": "PyBlade @match directive"
  },

  "PyBlade with": {
    "prefix": "@with",
    "body": ["@with(${1:name}=${2:value})", "\t$0", "@endwith"],
    "description": "PyBlade @with directive"
  },
  "PyBlade ifchanged": {
    "prefix": "@ifchanged",
    "body": ["@ifchanged(${1:variable})", "\t$0", "@endifchanged"],
    "description": "PyBlade @ifchanged directive"
  },

  "PyBlade for Loop": {
    "prefix": "@for",
    "body": ["@for(${1:variable} in ${2:iterable})", "\t$0", "@endfor"],
    "description": "Insert a PyBlade @for loop"
  },
  "PyBlade empty loop": {
    "prefix": "@empty",
    "body": ["@empty", "\t$0"],
    "description": "PyBlade @empty loop directive"
  },
  "PyBlade for empty loop": {
    "prefix": "@forempty",
    "body": ["@for(${1:variable} in ${2:iterable})", "\t$3", "@empty", "\t$0", "@endfor"],
    "description": "PyBlade @for ... @empty loop directive"
  },
  "PyBlade break directive": {
    "prefix": "@break",
    "body": ["@break"],
    "description": "PyBlade @break directive"
  },
  "PyBlade continue directive": {
    "prefix": "@continue",
    "body": ["@continue"],
    "description": "PyBlade @continue directive"
  },
  "PyBlade cycle": {
    "prefix": "@cycle",
    "body": ["@cycle(${1:'odd'}, ${2:'even'})"],
