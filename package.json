{
  "name": "pyblade-intellisense",
  "displayName": "PyBlade IntelliSense",
  "description": "IntelliSense and language support for PyBlade templates.",
  "version": "0.3.0",
  "publisher": "antares",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/AntaresMugisho/pyblade-vscode.git"
  },
  "author": {
    "name": "Antares Mugisho",
    "email": "antaresmugisho@gmail.com"
  },
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.91.0"
  },
  "keywords": [
    "pyblade",
    "python",
    "django",
    "flask",
    "templates",
    "snippets",
    "syntax highlighting"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "icon": "assets/pyblade.png",
  "activationEvents": [],
  "main": "./out/client/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pyblade",
        "aliases": [
          "PyBlade",
          "pyblade"
        ],
        "extensions": [
          ".html"
        ],
        "configuration": "./client/languages/pyblade.configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pyblade",
        "scopeName": "source.pyblade",
        "path": "./client/syntaxes/pyblade.tmLanguage.json",
        "embeddedLanguages": {
          "source.python": "python"
        }
      }
    ],
    "snippets": [
      {
        "language": "pyblade",
        "path": "./client/snippets/pyblade.snippets.json"
      }
    ],
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "pyblade": "html"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "bun run compile && bun run lint",
    "lint": "eslint client",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "1.91.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  }
}
